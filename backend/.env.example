# SQL Server Database Connection String Configuration
# To connect to your local SQL Server instance or Azure SQL Server, replace the connection string below:
ConnectionStrings__DefaultConnection="Data Source=YOUR_SERVER_NAME;Initial Catalog=ERMS_DB;Integrated Security=True;TrustServerCertificate=True"

# ASP.NET Core Environment Configuration
ASPNETCORE_ENVIRONMENT="Development"
ASPNETCORE_URLS="http://localhost:5000"
