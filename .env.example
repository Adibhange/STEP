# Used by `docker compose up` (see docker-compose.yml) to fill in the backend/frontend containers'
# environment. Copy this file to `.env` in this same directory and fill in real values — never
# commit the filled-in `.env`.

# SQL Server connection string for the ALREADY-EXISTING database — this does not create one.
DB_CONNECTION=Data Source=<host>;Initial Catalog=<db>;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True;

# 256-bit+ random secret — generate a fresh one for real deployments, never reuse a value that
# has ever appeared in source control or documentation. The API refuses to start without this.
JWT_SECRET=
JWT_ISSUER=STEP.Enterprise
JWT_AUDIENCE=STEP.Users

# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:7001

# Public URL candidates' QR scans should open (the frontend's /apply/{code} page) — baked into
# every generated QR code's registration link. Should match NEXT_PUBLIC_APP_URL below. No
# hardcoded fallback — QR generation fails with a clear error until this is set.
FRONTEND_URL=http://localhost:7001

ASPNETCORE_ENVIRONMENT=Production

# Baked into the frontend's client bundle at build time — must be the real, publicly reachable
# URLs for your deployment, not localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5125/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:7001
